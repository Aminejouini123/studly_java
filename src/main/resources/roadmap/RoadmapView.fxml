<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxWidth="Infinity" style="-fx-background-color: transparent;"
           stylesheets="@roadmap_styles.css"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.roadmap.RoadmapController">

    <!-- ══ Main content ════════════════════════════════════════════════════ -->
    <VBox maxWidth="Infinity" spacing="20" style="-fx-background-color: transparent;"
          StackPane.alignment="TOP_LEFT">
        <padding>
            <Insets bottom="60" />
        </padding>

        <!-- ── Panel header ──────────────────────────────────────────────── -->
        <VBox spacing="5">
            <Label styleClass="roadmap-panel-title" text="Smart Skill Roadmaps" />
            <Label styleClass="roadmap-panel-subtitle"
                   text="Type any skill and get an AI-generated, step-by-step learning path in seconds." />
        </VBox>

        <!-- ══ API KEY SETUP CARD ══════════════════════════════════════════ -->
        <!--  Shown on first launch (no key) or after a 401 (bad key).       -->
        <VBox fx:id="apiKeySetupPane" managed="false" visible="false"
              spacing="12" styleClass="api-setup-card">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="api-setup-title" text="OpenRouter API Key Required" />
                <Button mnemonicParsing="false" onAction="#openOpenRouterSite"
                        styleClass="api-link-btn" text="Get a free key at openrouter.ai →" />
            </HBox>

            <Label styleClass="api-setup-subtitle" wrapText="true"
                   text="1. Go to openrouter.ai   2. Sign in   3. Keys → Create Key   4. Paste below." />

            <HBox alignment="CENTER_LEFT" spacing="10">
                <TextField fx:id="apiKeyField" HBox.hgrow="ALWAYS" maxWidth="460"
                           styleClass="api-key-field"
                           promptText="sk-or-v1-…" />
                <Button mnemonicParsing="false" onAction="#handleSaveApiKey"
                        styleClass="api-save-btn" text="Save Key" />
            </HBox>

            <Label fx:id="keyPathLabel" styleClass="api-setup-note" text="Stored at: …" />
        </VBox>

        <!-- ── Search bar row ────────────────────────────────────────────── -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="skillInput" maxWidth="480" HBox.hgrow="NEVER"
                       styleClass="roadmap-search-field"
                       promptText="e.g.  Python,  Machine Learning,  React,  DevOps …" />
            <Button fx:id="generateBtn" mnemonicParsing="false"
                    onAction="#handleGenerate"
                    styleClass="roadmap-generate-btn" text="Generate Roadmap" />
            <!-- Visible when a key IS already saved — lets user swap it any time -->
            <Button fx:id="changeKeyBtn" mnemonicParsing="false"
                    onAction="#handleChangeKey"
                    styleClass="change-key-btn" text="Change API Key" />
        </HBox>

        <!-- ── Status / error label ──────────────────────────────────────── -->
        <Label fx:id="statusLabel" managed="false" visible="false"
               maxWidth="680" wrapText="true" />

        <!-- ── Section divider ───────────────────────────────────────────── -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="roadmap-section-label" text="YOUR ROADMAP" />
            <Region prefHeight="1" style="-fx-background-color: rgba(99,102,241,0.25);"
                    HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- ── Steps container ───────────────────────────────────────────── -->
        <VBox fx:id="roadmapContainer" spacing="0"
              style="-fx-background-color: transparent;" />

    </VBox>

    <!-- ══ Loading overlay ════════════════════════════════════════════════ -->
    <VBox fx:id="loadingOverlay" alignment="CENTER" managed="false" visible="false"
          spacing="14" styleClass="roadmap-loading-overlay"
          maxWidth="380" maxHeight="200"
          StackPane.alignment="CENTER">
        <padding>
            <Insets bottom="32" left="40" right="40" top="32" />
        </padding>
        <ProgressIndicator prefHeight="52" prefWidth="52"
                           style="-fx-progress-color: #A855F7;" />
        <Label styleClass="roadmap-loading-text" text="Generating your roadmap…" />
        <Label styleClass="roadmap-loading-subtext"
               text="The AI is designing a personalised learning path for you." />
    </VBox>

</StackPane>
