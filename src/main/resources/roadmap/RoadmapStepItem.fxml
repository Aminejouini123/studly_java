<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  One timeline step.
  Left column  : gradient circle (step number) + vertical connector line.
  Right column : glassmorphism card with title, description, resource buttons.
  Data injected by RoadmapStepController.setStep().
-->
<HBox alignment="TOP_LEFT" maxWidth="Infinity" spacing="0"
      style="-fx-background-color: transparent;"
      stylesheets="@roadmap_styles.css"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.roadmap.RoadmapStepController">

    <!-- ── Left: timeline column ─────────────────────────────────────────── -->
    <VBox alignment="TOP_CENTER" prefWidth="72" minWidth="72">

        <!-- Gradient circle with step number -->
        <StackPane alignment="CENTER" prefWidth="44" prefHeight="44"
                   styleClass="step-circle">
            <VBox.margin>
                <Insets left="14" />
            </VBox.margin>
            <Label fx:id="stepNumberLabel" styleClass="step-number" text="1" />
        </StackPane>

        <!-- Vertical connector line – hidden on the last step via controller -->
        <Region fx:id="timelineConnector" prefWidth="2" prefHeight="16"
                styleClass="timeline-connector" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets left="35" />
            </VBox.margin>
        </Region>

    </VBox>

    <!-- ── Right: glass card ─────────────────────────────────────────────── -->
    <VBox HBox.hgrow="ALWAYS" spacing="10" styleClass="step-card">
        <padding>
            <Insets bottom="24" left="20" right="20" top="16" />
        </padding>

        <!-- Step title -->
        <Label fx:id="titleLabel" maxWidth="Infinity" styleClass="step-title"
               text="Step Title" wrapText="true" />

        <!-- Description -->
        <Label fx:id="descriptionLabel" maxWidth="Infinity" styleClass="step-description"
               text="Description" wrapText="true" />

        <!-- Resource link buttons -->
        <FlowPane fx:id="resourcesContainer" hgap="8" vgap="8">
            <VBox.margin>
                <Insets top="4" />
            </VBox.margin>
        </FlowPane>

    </VBox>

    <!-- Gap between this card and the next (matches connector visual) -->
    <HBox.margin>
        <Insets bottom="0" right="4" />
    </HBox.margin>

</HBox>