<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  One roadmap step card.
  Data injected by RoadmapStepController.setStep().
-->
<HBox alignment="TOP_LEFT" maxWidth="Infinity" spacing="0"
      style="-fx-background-color: transparent;"
      stylesheets="@roadmap_styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.roadmap.RoadmapStepController">

    <!-- Right: glass card -->
    <VBox HBox.hgrow="ALWAYS" spacing="10" styleClass="step-card">
        <padding>
            <Insets bottom="24" left="20" right="20" top="16" />
        </padding>

        <!-- Step title row with completion checkbox -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <CheckBox fx:id="completedCheckBox" managed="false" visible="false"
                      styleClass="step-checkbox" />
            <Label fx:id="titleLabel" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                   styleClass="step-title" text="Step Title" wrapText="true" />
        </HBox>

        <!-- Description -->
        <Label fx:id="descriptionLabel" maxWidth="Infinity" styleClass="step-description"
               text="Description" wrapText="true" />

        <!-- Resource link buttons -->
        <FlowPane fx:id="resourcesContainer" hgap="8" vgap="8">
            <VBox.margin>
                <Insets top="4" />
            </VBox.margin>
        </FlowPane>

    </VBox>

    <!-- Gap between this card and the next -->
    <HBox.margin>
        <Insets bottom="0" right="4" />
    </HBox.margin>

</HBox>