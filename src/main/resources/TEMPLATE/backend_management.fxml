<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="root" stylesheets="@backend_style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BackendController">

   <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent;">
      
      <!-- Left Sidebar -->
      <left>
         <VBox prefWidth="250.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
               <VBox alignment="CENTER_LEFT" spacing="5.0">
                  <padding>
                     <Insets bottom="40.0" left="25.0" right="20.0" top="30.0" />
                  </padding>
                  <children>
                     <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <children>
                           <VBox>
                               <Label styleClass="brand-text" text="STUDLY" />
                               <Label styleClass="brand-subtitle" />
                           </VBox>
                        </children>
                     </HBox>
                  </children>
               </VBox>

               <VBox spacing="10.0">
                  <children>
                      <Button fx:id="overviewBtn" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" onAction="#showOverview" styleClass="nav-button" text="  OVERVIEW">
                         <graphic>
                            <SVGPath content="M 4 4 L 10 4 L 10 10 L 4 10 Z M 14 4 L 20 4 L 20 10 L 14 10 Z M 4 14 L 10 14 L 10 20 L 4 20 Z M 14 14 L 20 14 L 20 20 L 14 20 Z" fill="TRANSPARENT" stroke="#64748B" strokeWidth="1.5" />
                         </graphic>
                      </Button>
                      <Button fx:id="usersBtn" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" onAction="#showUsers" styleClass="nav-button-active" text="  USERS">
                         <graphic>
                            <SVGPath content="M 12 12 C 14.21 12 16 10.21 16 8 C 16 5.79 14.21 4 12 4 C 9.79 4 8 5.79 8 8 C 8 10.21 9.79 12 12 12 Z M 12 14 C 9.33 14 4 15.34 4 18 L 4 20 L 20 20 L 20 18 C 20 15.34 14.67 14 12 14 Z" fill="#38bdf8" />
                         </graphic>
                      </Button>
                      <Button fx:id="groupsBtn" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" onAction="#showGroups" styleClass="nav-button" text="  GROUPS">
                         <graphic>
                            <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V20h14v-3.5C15 14.17 10.33 13 8 13zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V20h6v-3.5c0-2.33-4.67-3.5-7-3.5z" fill="#64748B" />
                         </graphic>
                      </Button>
                      <Button fx:id="timeBtn" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" onAction="#showTimeManagement" styleClass="nav-button" text="  TIME">
                         <graphic>
                            <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="#64748B" />
                         </graphic>
                      </Button>
                      <Button fx:id="coursesBtn" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" onAction="#handleShowCourses" styleClass="nav-button" text="  COURSES">
                         <graphic>
                            <SVGPath content="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z" fill="#64748B" />
                         </graphic>
                      </Button>
                      <Region VBox.vgrow="ALWAYS" />
                      <Button fx:id="logoutBtn" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" onAction="#handleLogout" styleClass="nav-button" text="  SIGN OUT" textFill="#ef4444">
                         <graphic>
                            <SVGPath content="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5-5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" fill="#ef4444" />
                         </graphic>
                      </Button>
                   </children>
                </VBox>
            </children>
         </VBox>
      </left>
      
      <!-- Main Content Area -->
      <center>
         <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" BorderPane.alignment="CENTER">
            <children>
               <!-- Top App Bar -->
               <HBox alignment="CENTER_LEFT" prefHeight="61.0" spacing="20.0" styleClass="top-bar">
                  <padding>
                     <Insets left="30.0" right="30.0" />
                  </padding>
                  <children>
                     <Region HBox.hgrow="ALWAYS" />
                     <HBox alignment="CENTER" spacing="12.0">
                        <children>
                            <VBox alignment="CENTER_RIGHT">
                                <Label fx:id="adminNameLabel" style="-fx-text-fill: #1E293B; -fx-font-weight: bold; -fx-font-size: 13px;" text="Alex Chen" />
                                <Label fx:id="adminRoleLabel" style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-font-weight: bold;" text="CHIEF ARCHITECT" />
                            </VBox>
                            <Circle fx:id="adminAvatar" fill="#3b82f6" radius="16.0" />
                        </children>
                     </HBox>
                  </children>
               </HBox>

               <StackPane fx:id="mainContentHost" prefHeight="716.0" prefWidth="774.0" VBox.vgrow="ALWAYS">
                  <padding>
                     <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                  </padding>
               </StackPane>
            </children>
         </VBox>
      </center>
   </BorderPane>
</StackPane>
