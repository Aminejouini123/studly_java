<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" styleClass="root-pane" stylesheets="@auth.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.user_controller.ResetPasswordController">
    <children>
        <!-- Background decorative elements — same as auth page -->
        <Circle fill="#2464d1" layoutX="120.0" layoutY="120.0" opacity="0.4" radius="150.0" />
        <Circle fill="#0dcaf0" layoutX="100.0" layoutY="550.0" opacity="0.5" radius="50.0" />
        <Circle fill="#1d4899" layoutX="850.0" layoutY="200.0" opacity="0.6" radius="120.0" />
        <Rectangle arcHeight="60.0" arcWidth="60.0" fill="#377df0" height="60.0" layoutX="100.0" layoutY="350.0" opacity="0.7" rotate="45.0" width="160.0" />
        <Rectangle arcHeight="60.0" arcWidth="60.0" fill="#00c3ff" height="40.0" layoutX="160.0" layoutY="280.0" opacity="0.4" rotate="45.0" width="80.0" />
        <Rectangle arcHeight="60.0" arcWidth="60.0" fill="#295bb8" height="60.0" layoutX="-50.0" layoutY="550.0" opacity="0.8" rotate="45.0" width="160.0" />

        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="TOP_CENTER" minHeight="-Infinity" maxWidth="420.0" maxHeight="-Infinity"
                      spacing="10.0" styleClass="login-card" StackPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="35.0" left="40.0" right="40.0" top="35.0" />
                    </padding>
                    <children>
                        <!-- Title -->
                        <Label styleClass="login-title" text="Reset Password">
                            <VBox.margin><Insets bottom="8.0" /></VBox.margin>
                        </Label>

                        <!-- Email (pre-filled, read-only) -->
                        <Label styleClass="input-label" text="Email" />
                        <TextField fx:id="emailField" editable="false" styleClass="text-input-modern"
                                   promptText="your@email.com" />

                        <!-- Reset code -->
                        <Label styleClass="input-label" text="Reset Code">
                            <VBox.margin><Insets top="6.0" /></VBox.margin>
                        </Label>
                        <TextField fx:id="tokenField" promptText="6-digit code from email"
                                   styleClass="text-input-modern" />
                        <Label fx:id="tokenError" managed="false" styleClass="error-label"
                               text="" visible="false" />

                        <!-- New password -->
                        <Label styleClass="input-label" text="New Password">
                            <VBox.margin><Insets top="6.0" /></VBox.margin>
                        </Label>
                        <PasswordField fx:id="newPasswordField" promptText="Min. 6 characters"
                                       styleClass="text-input-modern" />
                        <Label fx:id="passwordError" managed="false" styleClass="error-label"
                               text="" visible="false" />

                        <!-- Confirm password -->
                        <Label styleClass="input-label" text="Confirm New Password">
                            <VBox.margin><Insets top="6.0" /></VBox.margin>
                        </Label>
                        <PasswordField fx:id="confirmPasswordField" promptText="Repeat new password"
                                       styleClass="text-input-modern" />
                        <Label fx:id="confirmError" managed="false" styleClass="error-label"
                               text="" visible="false" />

                        <!-- Submit button -->
                        <Button fx:id="resetButton" maxWidth="1.7976931348623157E308"
                                mnemonicParsing="false" onAction="#handleReset"
                                styleClass="signin-button" text="Set New Password">
                            <VBox.margin><Insets bottom="8.0" top="18.0" /></VBox.margin>
                        </Button>

                        <!-- Back link -->
                        <Hyperlink fx:id="backToLoginLink" onAction="#handleBack"
                                   styleClass="signup-link" text="← Back to Login" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>
