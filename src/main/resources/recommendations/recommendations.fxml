<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Recommendations panel — loaded into FrontendController's contentHost StackPane.
  Outer dashboard ScrollPane provides scrolling, so no nested ScrollPane here.
-->
<VBox spacing="28.0" style="-fx-background-color: transparent;"
      stylesheets="@recommendations.css"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.recommendations.RecommendationController">
    <padding>
        <Insets bottom="60.0" />
    </padding>
    <children>

        <!-- ══ Header ══════════════════════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="rec-panel-title" text="Recommendations For You" />
                        <Label styleClass="rec-panel-subtitle"
                               text="Personalized jobs and courses based on your skill profile" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#loadRecommendations"
                        styleClass="rec-refresh-btn" text="Refresh" />
            </children>
        </HBox>

        <!-- ══ Skill tags ═══════════════════════════════════════════════════════ -->
        <HBox fx:id="skillsContainer" alignment="CENTER_LEFT" spacing="8.0" />

        <!-- ══ Loading indicator ════════════════════════════════════════════════ -->
        <VBox fx:id="loadingPane" alignment="CENTER" prefHeight="220.0" spacing="16.0">
            <children>
                <ProgressIndicator fx:id="loadingSpinner" prefHeight="52.0" prefWidth="52.0"
                                   style="-fx-progress-color: #4b5ed4;" />
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 14px;"
                       text="Loading personalized recommendations…" />
            </children>
        </VBox>

        <!-- ══ Status / error message (managed=false hides it from layout) ══════ -->
        <Label fx:id="statusLabel" managed="false" visible="false"
               style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;" wrapText="true" />

        <!-- ══ Main content (revealed after load) ══════════════════════════════ -->
        <VBox fx:id="contentPane" managed="false" visible="false" spacing="36.0">
            <children>

                <!-- ── Job Matches section ── -->
                <VBox spacing="14.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label styleClass="rec-section-title" text="Job Matches" />
                                <Label fx:id="jobCountLabel" styleClass="rec-count-badge" text="0" />
                            </children>
                        </HBox>
                        <!-- Cards arranged in a wrapping flow -->
                        <FlowPane fx:id="jobsContainer" hgap="16.0" vgap="16.0"
                                  prefWrapLength="1080.0" />
                    </children>
                </VBox>

                <!-- ── Section separator ── -->
                <Region prefHeight="1.0" style="-fx-background-color: rgba(99,102,241,0.15);" />

                <!-- ── Course Recommendations section ── -->
                <VBox spacing="14.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label styleClass="rec-section-title" text="Course Recommendations" />
                                <Label fx:id="courseCountLabel" styleClass="rec-count-badge" text="0" />
                            </children>
                        </HBox>
                        <FlowPane fx:id="coursesContainer" hgap="16.0" vgap="16.0"
                                  prefWrapLength="1080.0" />
                    </children>
                </VBox>

            </children>
        </VBox>

    </children>
</VBox>